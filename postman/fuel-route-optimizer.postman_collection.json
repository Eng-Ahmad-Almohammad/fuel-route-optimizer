{
  "info": {
    "_postman_id": "b1ff2dc2-ed14-4d72-9ba5-a85551a8fcbb",
    "name": "Fuel Route Optimizer",
    "description": "Plan a US road trip with the cheapest fuel stops (500-mile range, 10 mpg).\n\nStart the server with `python manage.py runserver`, then run the requests in order. `base_url` defaults to http://localhost:8000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "1. New York → Los Angeles",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Has fuel stops and a total cost\", () => {",
              "    pm.expect(body.fuel_stops.length).to.be.above(0);",
              "    pm.expect(body.total_fuel_cost).to.be.above(0);",
              "});",
              "pm.test(\"Gallons = miles / 10 mpg\", () => pm.expect(body.total_gallons).to.be.closeTo(body.distance_miles / 10, 0.1));",
              "console.log(`${body.start.name} → ${body.finish.name}: ${body.distance_miles} mi, ${body.fuel_stops.length} stops, $${body.total_fuel_cost}, cached=${body.cached}`);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "description": "Cross-country trip. The first request makes the one call to OpenRouteService (about 1–1.5 s)."
      }
    },
    {
      "name": "2. Same trip again (cached)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Has fuel stops and a total cost\", () => {",
              "    pm.expect(body.fuel_stops.length).to.be.above(0);",
              "    pm.expect(body.total_fuel_cost).to.be.above(0);",
              "});",
              "pm.test(\"Gallons = miles / 10 mpg\", () => pm.expect(body.total_gallons).to.be.closeTo(body.distance_miles / 10, 0.1));",
              "console.log(`${body.start.name} → ${body.finish.name}: ${body.distance_miles} mi, ${body.fuel_stops.length} stops, $${body.total_fuel_cost}, cached=${body.cached}`);",
              "pm.test(\"Served from cache\", () => pm.expect(body.cached).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "description": "Identical trip: served from the cache without calling the routing API (about 10 ms)."
      }
    },
    {
      "name": "3. Chicago → Houston (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Has fuel stops and a total cost\", () => {",
              "    pm.expect(body.fuel_stops.length).to.be.above(0);",
              "    pm.expect(body.total_fuel_cost).to.be.above(0);",
              "});",
              "pm.test(\"Gallons = miles / 10 mpg\", () => pm.expect(body.total_gallons).to.be.closeTo(body.distance_miles / 10, 0.1));",
              "console.log(`${body.start.name} → ${body.finish.name}: ${body.distance_miles} mi, ${body.fuel_stops.length} stops, $${body.total_fuel_cost}, cached=${body.cached}`);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/route/?start=Chicago, IL&finish=Houston, TX",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            },
            {
              "key": "finish",
              "value": "Houston, TX"
            }
          ]
        },
        "description": "The same endpoint also accepts query parameters."
      }
    },
